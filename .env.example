# Required by main.py. Replace local placeholders in your private .env.
DB_HOST=localhost
DB_NAME=trustvault_db
DB_USER=trustvault_app
DB_PASSWORD=replace_with_local_database_password
DB_PORT=5432

# Required: generate a unique random key with at least 32 characters.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters

# Required only when running seed_demo.py in a disposable development database.
SEED_ADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
SEED_VIEWER_PASSWORD=

# Optional email overrides for seed_demo.py; defaults are the example addresses.
SEED_ADMIN_EMAIL=admin.test@example.com
SEED_OWNER_EMAIL=owner.test@example.com
SEED_VIEWER_EMAIL=viewer.test@example.com

# Optional for the matching database integration tests in test_main.py.
# Use the passwords for the already-seeded local accounts.
TEST_ADMIN_PASSWORD=
TEST_OWNER_PASSWORD=
